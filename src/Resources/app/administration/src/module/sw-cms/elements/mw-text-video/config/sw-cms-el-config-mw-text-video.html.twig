<div class="sw-cms-el-config-mw-text-video">
    <sw-tabs defaultItem="content" position="left">
        <template #default="{ active }">
            <sw-tabs-item name="content" :active="active === 'content'">
                {{ $tc('mw-cms.elements.mwTextVideo.config.tabs.content') }}
            </sw-tabs-item>
            <sw-tabs-item name="media" :active="active === 'media'">
                {{ $tc('mw-cms.elements.mwTextVideo.config.tabs.media') }}
            </sw-tabs-item>
        </template>

        <template #content="{ active }">
            <!-- Content Tab (Left Side Settings) -->
            <div v-if="active === 'content'" class="sw-cms-el-config-mw-text-video__tab-content">
                <sw-text-field
                    v-model:value="element.config.heading.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.heading')"
                    @update:value="onConfigInput">
                </sw-text-field>

                <sw-colorpicker
                    v-model:value="element.config.headingColor.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.headingColor')"
                    @update:value="onConfigInput">
                </sw-colorpicker>

                <p class="sw-cms-el-config-mw-text-video__label" style="font-size: 13px; font-weight: 600; color: #334155; margin-top: 12px; margin-bottom: 6px;">
                    {{ $tc('mw-cms.elements.mwTextVideo.config.labels.subHeading') }}
                </p>
                <sw-text-editor
                    v-model:value="element.config.subHeading.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.subHeading')"
                    sanitize-input
                    @update:value="onConfigInput">
                </sw-text-editor>

                <sw-colorpicker
                    v-model:value="element.config.subHeadingColor.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.subHeadingColor')"
                    @update:value="onConfigInput">
                </sw-colorpicker>

                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #e2e8f0;" />

                <!-- Primary Button Settings -->
                <sw-switch-field
                    v-model:value="element.config.showPrimaryButton.value"
                    label="Show Primary Button"
                    @update:value="onConfigInput">
                </sw-switch-field>

                <template v-if="element.config.showPrimaryButton.value">
                    <p style="font-size: 13px; font-weight: 700; color: $sw-color-brand-secondary; margin-top: 10px; margin-bottom: 10px;">Primary Button Settings</p>
                    <sw-text-field
                        v-model:value="element.config.buttonText.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonText')"
                        @update:value="onConfigInput">
                    </sw-text-field>

                    <sw-colorpicker
                        v-model:value="element.config.buttonBgColor.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonBgColor')"
                        @update:value="onConfigInput">
                    </sw-colorpicker>

                    <sw-colorpicker
                        v-model:value="element.config.buttonTextColor.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonTextColor')"
                        @update:value="onConfigInput">
                    </sw-colorpicker>

                    <sw-select-field
                        v-model:value="element.config.buttonLinkType.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonLinkType')"
                        @update:value="onConfigInput">
                        <option value="external">External Link</option>
                        <option value="category">Category Link</option>
                    </sw-select-field>

                    <sw-text-field
                        v-model:value="element.config.buttonLink.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonLink')"
                        @update:value="onConfigInput">
                    </sw-text-field>

                    <sw-select-field
                        v-model:value="element.config.buttonLinkTarget.value"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.buttonLinkTarget')"
                        @update:value="onConfigInput">
                        <option value="_self">Same Tab (_self)</option>
                        <option value="_blank">New Tab (_blank)</option>
                    </sw-select-field>
                </template>

                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #e2e8f0;" />

                <!-- Secondary Button Settings -->
                <sw-switch-field
                    v-model:value="element.config.showSecondaryButton.value"
                    label="Show Secondary Button"
                    @update:value="onConfigInput">
                </sw-switch-field>

                <template v-if="element.config.showSecondaryButton.value">
                    <p style="font-size: 13px; font-weight: 700; color: #1e293b; margin-top: 10px; margin-bottom: 10px;">Secondary Button Settings</p>
                    <sw-text-field
                        v-model:value="element.config.button2Text.value"
                        label="Secondary Button Text"
                        placeholder="e.g. Learn More"
                        @update:value="onConfigInput">
                    </sw-text-field>

                    <sw-colorpicker
                        v-model:value="element.config.button2BgColor.value"
                        label="Secondary Button Background Color"
                        @update:value="onConfigInput">
                    </sw-colorpicker>

                    <sw-colorpicker
                        v-model:value="element.config.button2TextColor.value"
                        label="Secondary Button Text Color"
                        @update:value="onConfigInput">
                    </sw-colorpicker>

                    <sw-select-field
                        v-model:value="element.config.button2LinkType.value"
                        label="Secondary Button Link Type"
                        @update:value="onConfigInput">
                        <option value="external">External Link</option>
                        <option value="category">Category Link</option>
                    </sw-select-field>

                    <sw-text-field
                        v-model:value="element.config.button2Link.value"
                        label="Secondary Button Link URL"
                        @update:value="onConfigInput">
                    </sw-text-field>

                    <sw-select-field
                        v-model:value="element.config.button2LinkTarget.value"
                        label="Secondary Button Link Target"
                        @update:value="onConfigInput">
                        <option value="_self">Same Tab (_self)</option>
                        <option value="_blank">New Tab (_blank)</option>
                    </sw-select-field>
                </template>
            </div>

            <!-- Media Tab (Right Side Settings) -->
            <div v-if="active === 'media'" class="sw-cms-el-config-mw-text-video__tab-content">
                <sw-select-field
                    v-model:value="element.config.mediaType.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.mediaType')"
                    @update:value="onConfigInput">
                    <option value="image">Image</option>
                    <option value="video">Video</option>
                </sw-select-field>

                <div class="sw-cms-el-config-mw-text-video__media-upload">
                    <sw-media-upload-v2
                        variant="regular"
                        :uploadTag="uploadTag"
                        :source="previewSource"
                        :allowMultiSelect="false"
                        :defaultFolder="element.config.mediaFile.entity.name"
                        :label="$tc('mw-cms.elements.mwTextVideo.config.labels.mediaFile')"
                        @media-upload-sidebar-open="onOpenMediaModal"
                        @media-upload-remove-image="onImageRemove">
                    </sw-media-upload-v2>

                    <sw-upload-listener
                        :uploadTag="uploadTag"
                        autoUpload
                        @media-upload-finish="onImageUpload">
                    </sw-upload-listener>
                </div>

                <sw-text-field
                    v-model:value="element.config.mediaLink.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.mediaLink')"
                    placeholder="Enter video URL (e.g. YouTube / Vimeo / HTML5) or general link"
                    @update:value="onConfigInput">
                </sw-text-field>

                <sw-select-field
                    v-model:value="element.config.mediaLinkTarget.value"
                    :label="$tc('mw-cms.elements.mwTextVideo.config.labels.mediaLinkTarget')"
                    @update:value="onConfigInput">
                    <option value="_self">Same Tab (_self)</option>
                    <option value="_blank">New Tab (_blank)</option>
                </sw-select-field>
            </div>
        </template>
    </sw-tabs>

    <sw-media-modal-v2
        v-if="mediaModalIsOpen"
        variant="full"
        @modal-close="onCloseModal"
        @media-modal-selection-change="onSelectionChanges">
    </sw-media-modal-v2>
</div>
