{% block sw_cms_el_mw_before_after %}
    <div class="sw-cms-el-mw-before-after">
        <div v-if="items.length === 0" class="mw-before-after-empty-admin">
            MW Before-After Columns
        </div>

        <div v-else class="mw-before-after-grid-admin" :class="{ 'is--single-column': columns === 1 }" :style="{ gridTemplateColumns: 'repeat(' + columns + ', minmax(0, 1fr))' }">
            <div v-for="(item, index) in items" :key="index" class="mw-before-after-card-admin">
                <h4 v-if="element.config.showHeading.value !== false" class="mw-before-after-card-admin__heading" :style="{ color: element.config.headingColor.value, backgroundColor: element.config.headingBackgroundColor.value }">
                    {{ element.config.heading.value || 'Heading' }}
                </h4>
                <p v-if="element.config.showSubHeading.value !== false && element.config.subHeading.value" class="mw-before-after-card-admin__subheading">
                    {{ element.config.subHeading.value }}
                </p>
                <p v-if="element.config.showDescription.value !== false && element.config.description.value" class="mw-before-after-card-admin__description">
                    {{ element.config.description.value }}
                </p>

                <div class="mw-before-after-slider-admin">
                    <!-- Before Image -->
                    <div class="mw-before-after-img-wrap-admin before">
                        <img v-if="item.beforeImageUrl" :src="item.beforeImageUrl" alt="Before" />
                        <div v-else class="mw-before-after-placeholder-admin">Before Image</div>
                    </div>

                    <!-- After Image (50% overlay) -->
                    <div class="mw-before-after-img-wrap-admin after" :style="{ width: '50%' }">
                        <img v-if="item.afterImageUrl" :src="item.afterImageUrl" alt="After" />
                        <div v-else class="mw-before-after-placeholder-admin">After Image</div>
                    </div>

                    <!-- Split Handle Mock -->
                    <div class="mw-before-after-handle-admin" :style="{ left: '50%' }">
                        <div class="mw-before-after-handle-line-admin"></div>
                        <div class="mw-before-after-handle-btn-admin">
                            <span class="swap-icon-admin">⇄</span>
                        </div>
                        <div class="mw-before-after-handle-line-admin"></div>
                    </div>
                </div>

                <div class="mw-before-after-card-admin__info">
                    <p v-if="item.beforeText" class="mw-before-after-card-admin__text">
                        <strong :style="{ color: item.beforeTextColor, backgroundColor: item.beforeTextBackgroundColor }">
                            {{ item.beforeText }}
                        </strong>
                    </p>
                    <p v-if="item.beforeDescription" class="mw-before-after-card-admin__description">
                        {{ item.beforeDescription }}
                    </p>
                    <p v-if="item.afterText" class="mw-before-after-card-admin__text">
                        <strong :style="{ color: item.afterTextColor, backgroundColor: item.afterTextBackgroundColor }">
                            {{ item.afterText }}
                        </strong>
                    </p>
                    <p v-if="item.afterDescription" class="mw-before-after-card-admin__description">
                        {{ item.afterDescription }}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
