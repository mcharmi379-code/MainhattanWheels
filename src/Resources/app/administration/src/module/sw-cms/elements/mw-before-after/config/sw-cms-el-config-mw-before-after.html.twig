{% block sw_cms_el_config_mw_before_after %}
    <div class="sw-cms-el-config-mw-before-after">
        <sw-tabs default-item="settings">
            <template #default="{ active }">
                <sw-tabs-item name="settings" :active-tab="active">Settings</sw-tabs-item>
                <sw-tabs-item name="items" :active-tab="active">Items (Columns)</sw-tabs-item>
            </template>

            <template #content="{ active }">
                {# Settings Tab #}
                <sw-container v-if="active === 'settings'" class="mw-before-after-config__settings">
                    <sw-single-select
                        v-model:value="element.config.columns.value"
                        label="Columns"
                        :options="columnsOptions"
                        @update:value="onInput"
                    />
                    <sw-switch-field
                        v-model:value="element.config.showHeading.value"
                        label="Show title"
                        @update:value="onInput"
                    />
                    <sw-switch-field
                        v-model:value="element.config.showSubHeading.value"
                        label="Show subtitle"
                        @update:value="onInput"
                    />
                    <sw-switch-field
                        v-model:value="element.config.showDescription.value"
                        label="Show description"
                        @update:value="onInput"
                    />
                    <sw-switch-field
                        v-model:value="element.config.showTagsOnImage.value"
                        label="Show tags on image"
                        @update:value="onInput"
                    />
                    <div class="config-row-2">
                        <mt-text-field
                            :model-value="element.config.heading.value"
                            label="Title"
                            @update:model-value="element.config.heading.value = $event; onInput()"
                        />
                        <sw-colorpicker
                            v-model:value="element.config.headingColor.value"
                            label="Title text color"
                            color-output="hex"
                            :z-index="1000"
                            @update:value="onInput"
                        />
                    </div>
                    <sw-colorpicker
                        v-model:value="element.config.headingBackgroundColor.value"
                        label="Title background color"
                        color-output="hex"
                        :z-index="1000"
                        @update:value="onInput"
                    />
                    <mt-text-field
                        v-if="element.config.showSubHeading.value !== false"
                        :model-value="element.config.subHeading.value"
                        label="Subtitle"
                        @update:model-value="element.config.subHeading.value = $event; onInput()"
                    />
                    <mt-text-field
                        v-if="element.config.showDescription.value !== false"
                        :model-value="element.config.description.value"
                        label="Description"
                        @update:model-value="element.config.description.value = $event; onInput()"
                    />
                </sw-container>

                {# Items Tab #}
                <sw-container v-if="active === 'items'" class="mw-before-after-config__items">
                    {# Item Selector Tabs #}
                    <div class="mw-ba-item-tabs">
                        <button
                            v-for="(item, index) in items"
                            :key="item.id || index"
                            class="mw-ba-item-tab"
                            :class="{ 'is--active': activeItemIndex === index, 'is--dragging': draggedItemIndex === index }"
                            type="button"
                            draggable="true"
                            @click="selectItem(index)"
                            @dragstart="onItemDragStart(index, $event)"
                            @dragover="onItemDragOver(index, $event)"
                            @drop="onItemDrop(index, $event)"
                            @dragend="onItemDragEnd"
                        >
                            Column {{ index + 1 }}
                            <span
                                class="mw-ba-item-tab__move"
                                @click.stop="moveItem(index, -1)"
                                :class="{ 'is--disabled': index === 0 }"
                                title="Move left"
                            >‹</span>
                            <span
                                class="mw-ba-item-tab__move"
                                @click.stop="moveItem(index, 1)"
                                :class="{ 'is--disabled': index === items.length - 1 }"
                                title="Move right"
                            >›</span>
                            <span
                                class="mw-ba-item-tab__remove"
                                @click.stop="removeItem(index)"
                            >✕</span>
                        </button>

                        <button
                            class="mw-ba-item-tab mw-ba-item-tab--add"
                            type="button"
                            @click="addItem"
                        >
                            + Add Column
                        </button>
                    </div>

                    {# Active Item Form #}
                    <template v-if="activeItem !== null">
                        <!-- Before Section -->
                        <div class="mw-ba-section-divider">Before Image Settings</div>
                        <div class="mw-ba-media-upload-section">
                            <p class="mw-ba-upload-label">Before Image</p>
                            <sw-media-upload-v2
                                variant="regular"
                                :upload-tag="beforeUploadTag"
                                :source="beforePreview"
                                :allow-multi-select="false"
                                :default-folder="cmsPageState.pageEntityName"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                @media-upload-sidebar-open="beforeMediaModalOpen = true"
                                @media-upload-remove-image="onBeforeImageRemove"
                            />
                            <sw-upload-listener
                                :upload-tag="beforeUploadTag"
                                auto-upload
                                @media-upload-finish="onBeforeImageUpload"
                            />
                            <sw-media-modal-v2
                                v-if="beforeMediaModalOpen"
                                variant="full"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                :allow-multi-select="false"
                                @media-modal-selection-change="onBeforeMediaSelection"
                                @modal-close="beforeMediaModalOpen = false"
                            />
                        </div>
                        <div class="config-row-2">
                            <mt-text-field
                                :model-value="activeItem.beforeText"
                                label="Before tag"
                                @update:model-value="updateActiveField('beforeText', $event)"
                            />
                            <sw-colorpicker
                                v-model:value="activeItem.beforeTextColor"
                                label="Before tag text color"
                                color-output="hex"
                                :z-index="1000"
                                @update:value="onInput"
                            />
                        </div>
                        <sw-colorpicker
                            v-model:value="activeItem.beforeTextBackgroundColor"
                            label="Before tag background color"
                            color-output="hex"
                            :z-index="1000"
                            @update:value="onInput"
                        />
                        <mt-text-field
                            :model-value="activeItem.beforeDescription"
                            label="Before description"
                            @update:model-value="updateActiveField('beforeDescription', $event)"
                        />
                        <sw-switch-field
                            v-model:value="activeItem.showBeforeText"
                            label="Show before tag"
                            @update:value="onInput"
                        />

                        <!-- After Section -->
                        <div class="mw-ba-section-divider">After Image Settings</div>
                        <div class="mw-ba-media-upload-section">
                            <p class="mw-ba-upload-label">After Image</p>
                            <sw-media-upload-v2
                                variant="regular"
                                :upload-tag="afterUploadTag"
                                :source="afterPreview"
                                :allow-multi-select="false"
                                :default-folder="cmsPageState.pageEntityName"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                @media-upload-sidebar-open="afterMediaModalOpen = true"
                                @media-upload-remove-image="onAfterImageRemove"
                            />
                            <sw-upload-listener
                                :upload-tag="afterUploadTag"
                                auto-upload
                                @media-upload-finish="onAfterImageUpload"
                            />
                            <sw-media-modal-v2
                                v-if="afterMediaModalOpen"
                                variant="full"
                                :caption="$tc('sw-cms.elements.general.config.caption.mediaUpload')"
                                :allow-multi-select="false"
                                @media-modal-selection-change="onAfterMediaSelection"
                                @modal-close="afterMediaModalOpen = false"
                            />
                        </div>
                        <div class="config-row-2">
                            <mt-text-field
                                :model-value="activeItem.afterText"
                                label="After tag"
                                @update:model-value="updateActiveField('afterText', $event)"
                            />
                            <sw-colorpicker
                                v-model:value="activeItem.afterTextColor"
                                label="After tag text color"
                                color-output="hex"
                                :z-index="1000"
                                @update:value="onInput"
                            />
                        </div>
                        <sw-colorpicker
                            v-model:value="activeItem.afterTextBackgroundColor"
                            label="After tag background color"
                            color-output="hex"
                            :z-index="1000"
                            @update:value="onInput"
                        />
                        <mt-text-field
                            :model-value="activeItem.afterDescription"
                            label="After description"
                            @update:model-value="updateActiveField('afterDescription', $event)"
                        />
                    </template>

                    <p v-else class="mw-ba-empty-hint">
                        Click "+ Add Column" to add items.
                    </p>
                </sw-container>
            </template>
        </sw-tabs>
    </div>
{% endblock %}
