{% block sw_cms_el_config_mw_image_hotspot %}
<div class="sw-cms-el-config-mw-image-hotspot">

    <!-- Upload Listeners (Critical for sw-media-upload-v2 file uploads to trigger/succeed) -->
    <sw-upload-listener
        :upload-tag="'mw-image-hotspot-icon-tab' + activeConfigTab"
        auto-upload
        @media-upload-finish="onIconUploadSuccess"
    />

    <sw-upload-listener
        :upload-tag="'mw-image-hotspot-image-tab' + activeConfigTab"
        auto-upload
        @media-upload-finish="onMediaUploadSuccess"
    />

    <!-- General Options & Colors -->
    <p style="font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;">Tooltip Colors</p>
    <div style="display: flex; gap: 10px; margin-bottom: 20px;">
        <sw-colorpicker
            v-model:value="element.config.tooltipBgColor.value"
            label="Tooltip Background"
            @update:value="onInput"
            style="flex: 1;"
        />
        <sw-colorpicker
            v-model:value="element.config.tooltipTextColor.value"
            label="Tooltip Text Color"
            @update:value="onInput"
            style="flex: 1;"
        />
    </div>

    <!-- Tabs List Actions & Accordion Editor -->
    <div style="margin-bottom: 20px;">
        <p style="font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 12px;">Tabs Configuration (Accordion)</p>
        
        <!-- Accordion Items loop for tab configurations -->
        <div 
            v-for="t in tabCount" 
            :key="t" 
            style="border: 1px solid #cbd5e1; border-radius: 6px; margin-bottom: 12px; overflow: hidden; background: #fff;"
        >
            <!-- Accordion Header -->
            <div 
                style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; cursor: pointer; background: #f8fafc; user-select: none;"
                @click="setActiveConfigTab(t === activeConfigTab ? 0 : t)"
            >
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="font-weight: 700; color: $sw-color-brand-secondary;">Tab {{ t }}</span>
                    <span style="font-size: 12px; color: #475569;">{{ element.config['tab' + t + 'Title'].value || 'Unnamed' }}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <sw-button
                        v-if="tabCount > 1"
                        variant="ghost"
                        size="x-small"
                        style="color: #dc2626; border-color: #fecaca; background: #fee2e2;"
                        @click.stop="removeTab(t)"
                    >
                        <sw-icon name="regular-trash" size="10" />
                    </sw-button>
                    <span style="font-size: 12px; color: #94a3b8;">
                        {{ t === activeConfigTab ? '▲' : '▼' }}
                    </span>
                </div>
            </div>

            <!-- Accordion Content (Only visible if active tab is selected) -->
            <div 
                v-if="t === activeConfigTab" 
                style="padding: 16px; border-top: 1px solid #cbd5e1; background: #fff;"
            >
                <!-- Tab Title -->
                <sw-text-field
                    v-model:value="element.config['tab' + t + 'Title'].value"
                    label="Tab Title"
                    placeholder="e.g. BASISPAKET OFENWAGEN"
                    @update:value="onInput"
                />

                <!-- Tab Header Icon/Image -->
                <p style="font-size: 13px; font-weight: 600; color: #334155; margin-top: 15px; margin-bottom: 8px;">
                    Tab {{ t }} Header Icon/Image
                </p>
                <sw-media-upload-v2
                    :upload-tag="'mw-image-hotspot-icon-tab' + t"
                    :source="element.config['tab' + t + 'IconId'].value"
                    :allow-multi-select="false"
                    file-accept="image/*"
                    variant="regular"
                    @media-upload-remove-image="onRemoveIcon"
                />

                <!-- Tab Base Content Image -->
                <p style="font-size: 13px; font-weight: 600; color: #334155; margin-top: 15px; margin-bottom: 8px;">
                    Tab {{ t }} Main Content Background Image (Hotspot diagram)
                </p>
                <sw-media-upload-v2
                    :upload-tag="'mw-image-hotspot-image-tab' + t"
                    :source="element.config['tab' + t + 'MediaId'].value"
                    :allow-multi-select="false"
                    file-accept="image/*"
                    variant="regular"
                    @media-upload-remove-image="onRemoveMedia"
                />

                <!-- Tab Hotspot Count -->
                <sw-number-field
                    v-model:value="element.config['tab' + t + 'HotspotCount'].value"
                    label="Number of Hotspots for this Tab"
                    :min="1"
                    :max="5"
                    :step="1"
                    style="margin-top: 15px;"
                    @update:value="onInput"
                />

                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #e2e8f0;" />

                <!-- Hotspots Positioning and Content Editor for Active Tab -->
                <div 
                    v-for="h in parseInt(element.config['tab' + t + 'HotspotCount'].value || 3, 10)" 
                    :key="h" 
                    style="margin-bottom: 20px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #f8fafc;"
                >
                    <h4 style="margin-top: 0; margin-bottom: 12px; color: $sw-color-brand-secondary;">Hotspot {{ h }} Settings</h4>

                    <!-- Position Inputs -->
                    <div style="display: flex; gap: 10px;">
                        <sw-number-field
                            v-model:value="element.config['tab' + t + 'Hotspot' + h + 'Top'].value"
                            label="Top Position (%)"
                            :min="0"
                            :max="100"
                            :step="0.5"
                            @update:value="onInput"
                            style="flex: 1;"
                        />

                        <sw-number-field
                            v-model:value="element.config['tab' + t + 'Hotspot' + h + 'Left'].value"
                            label="Left Position (%)"
                            :min="0"
                            :max="100"
                            :step="0.5"
                            @update:value="onInput"
                            style="flex: 1;"
                        />
                    </div>

                    <!-- Content Inputs -->
                    <sw-text-field
                        v-model:value="element.config['tab' + t + 'Hotspot' + h + 'Title'].value"
                        label="Tooltip Title"
                        placeholder="e.g. Pulverkabine"
                        @update:value="onInput"
                        style="margin-top: 10px;"
                    />

                    <sw-textarea-field
                        v-model:value="element.config['tab' + t + 'Hotspot' + h + 'Text'].value"
                        label="Tooltip Content"
                        placeholder="Enter description text..."
                        :rows="3"
                        @update:value="onInput"
                    />
                </div>

                <hr style="margin: 20px 0; border: 0; border-top: 1px solid #e2e8f0;" />

                <!-- Optional Additional Dynamic Content Elements for Active Tab -->
                <p style="font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 8px;">
                    Additional Dynamic Content Elements (optional)
                </p>

                <div
                    v-for="d in parseInt(element.config['tab' + t + 'DynamicCount'].value || 0, 10)"
                    :key="'dyn-' + t + '-' + d"
                    style="margin-top: 14px; padding: 12px; border: 1px solid #cbd5e1; border-radius: 6px; background: #f8fafc;"
                >
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <h4 style="margin: 0; color: $sw-color-brand-secondary;">Dynamic Element {{ d }}</h4>
                        <sw-button
                            variant="ghost"
                            size="x-small"
                            style="color: #dc2626; border-color: #fecaca; background: #fee2e2;"
                            @click="removeDynamicElement(t, d)"
                        >
                            <sw-icon name="regular-trash" size="10" />
                        </sw-button>
                    </div>

                    <sw-single-select
                        :options="dynamicElementTypeOptions"
                        :value="dynamicElementType(t, d)"
                        label="Element Type"
                        placeholder="Select an element type..."
                        @update:value="(value) => onDynamicTypeChange(t, d, value)"
                    />

                    <div v-if="dynamicElementType(t, d) && dynamicConfigComponent(t, d)" style="margin-top: 10px;">
                        <component
                            :is="dynamicConfigComponent(t, d)"
                            :element="getDynamicElement(t, d)"
                            @element-update="(updated) => onDynamicElementUpdate(t, d, updated)"
                        />
                    </div>
                    <p v-else-if="dynamicElementType(t, d)" style="margin-top: 10px; font-size: 12px; color: #94a3b8; font-style: italic;">
                        This element type has no additional settings to configure.
                    </p>
                </div>

                <sw-button
                    v-if="parseInt(element.config['tab' + t + 'DynamicCount'].value || 0, 10) < 5"
                    variant="ghost"
                    size="small"
                    style="color: $sw-color-brand-secondary; border-color: $sw-color-brand-secondary; margin-top: 10px;"
                    @click="addDynamicElement(t)"
                >
                    + Add Dynamic Element
                </sw-button>
            </div>
        </div>

        <!-- Add Tab Button -->
        <sw-button 
            v-if="tabCount < 8" 
            variant="ghost" 
            size="small" 
            style="color: $sw-color-brand-secondary; border-color: $sw-color-brand-secondary;"
            @click="addTab"
        >
            + Add Tab
        </sw-button>
    </div>

</div>
{% endblock %}
