{% block element_mw_file_download %}
    {% set data = element.data ?? {} %}
    {% set config = element.config ?? {} %}
    {% set downloadTitle = data.downloadTitle ?? config.downloadTitle.value ?? '' %}
    {% set downloadSubtitle = data.downloadSubtitle ?? config.downloadSubtitle.value ?? '' %}
    {% set downloadButtonText = data.downloadButtonText ?? config.downloadButtonText.value ?? '' %}
    {% set downloadFile = data.downloadFile ?? null %}
    {% set downloadFileUrl = config.downloadFileUrl.value ?? data.downloadFileUrl ?? (downloadFile ? downloadFile.url : '') %}
    {% set downloadPreviewImage = data.downloadPreviewImage ?? null %}
    {% set downloadPreviewImageUrl = config.downloadPreviewImageUrl.value ?? data.downloadPreviewImageUrl ?? (downloadPreviewImage ? downloadPreviewImage.url : '') %}
    {% set downloadHasContent = downloadTitle is not empty or downloadSubtitle is not empty or downloadButtonText is not empty or downloadFileUrl is not empty or downloadPreviewImageUrl is not empty %}
    {% set ctaTitle = data.ctaTitle ?? config.ctaTitle.value ?? '' %}
    {% set ctaSubtitle = data.ctaSubtitle ?? config.ctaSubtitle.value ?? '' %}
    {% set ctaButtonText = data.ctaButtonText ?? config.ctaButtonText.value ?? '' %}
    {% set ctaButtonUrl = data.ctaButtonUrl ?? config.ctaButtonUrl.value ?? '' %}
    {% set ctaPreviewImage = data.ctaPreviewImage ?? null %}
    {% set ctaPreviewImageUrl = config.ctaPreviewImageUrl.value ?? data.ctaPreviewImageUrl ?? (ctaPreviewImage ? ctaPreviewImage.url : '') %}
    {% set ctaHasContent = ctaTitle is not empty or ctaSubtitle is not empty or ctaButtonText is not empty or ctaButtonUrl is not empty or ctaPreviewImageUrl is not empty %}
    
    <section class="mw-file-download">
        <div class="mw-file-download__grid">
            {% if downloadHasContent %}
                <article class="mw-file-download__card mw-file-download__card--download">
                    <div class="mw-file-download__row">
                        {% if downloadPreviewImageUrl %}
                            <div class="mw-file-download__image">
                                <img src="{{ downloadPreviewImageUrl }}" alt="{{ downloadTitle }}" loading="lazy" decoding="async">
                            </div>
                        {% endif %}

                        {% if downloadTitle or downloadSubtitle %}
                            <div class="mw-file-download__body">
                                {% if downloadTitle %}<h3 class="mw-file-download__title">{{ downloadTitle }}</h3>{% endif %}
                                {% if downloadSubtitle %}<p class="mw-file-download__subtitle">{{ downloadSubtitle }}</p>{% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {% if downloadButtonText %}
                        {% if downloadFileUrl %}
                            <a class="mw-file-download__btn" href="{{ downloadFileUrl }}" download>
                                {{ downloadButtonText }}
                            </a>
                        {% else %}
                            <span class="mw-file-download__btn is--disabled" aria-disabled="true">
                                {{ downloadButtonText }}
                            </span>
                        {% endif %}
                    {% endif %}
                </article>
            {% endif %}

            {% if ctaHasContent %}
                <article class="mw-file-download__card mw-file-download__card--cta">
                    <div class="mw-file-download__row">
                        {% if ctaPreviewImageUrl %}
                            <div class="mw-file-download__image">
                                <img src="{{ ctaPreviewImageUrl }}" alt="{{ ctaTitle }}" loading="lazy" decoding="async">
                            </div>
                        {% endif %}

                        {% if ctaTitle or ctaSubtitle %}
                            <div class="mw-file-download__body">
                                {% if ctaTitle %}<h3 class="mw-file-download__title">{{ ctaTitle }}</h3>{% endif %}
                                {% if ctaSubtitle %}<p class="mw-file-download__subtitle">{{ ctaSubtitle }}</p>{% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {% if ctaButtonText %}
                        {% set url = ctaButtonUrl ?: '#' %}
                        <a class="mw-file-download__btn" href="{{ url }}">
                            {{ ctaButtonText }}
                        </a>
                    {% endif %}
                </article>
            {% endif %}
        </div>
    </section>
{% endblock %}
