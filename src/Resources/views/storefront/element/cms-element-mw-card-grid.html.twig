{% block element_mw_card_grid %}
    {% set c = element.config %}
    {% set cards = c.cards.value ?? [] %}
    {% set columns = c.columns.value ?? 4 %}
    {% set titleBesideBadge = c.titleBesideBadge.value is same as(true) %}

    <div class="cms-element-mw-card-grid mw-card-grid{% if titleBesideBadge %} is--title-beside-badge{% endif %}" style="--mw-card-grid-columns: {{ columns }};">
        {% for card in cards %}
            {% set index = loop.index %}
            {% set iconUrl = card.iconUrl ?? null %}
            {% set iconMimeType = card.iconMimeType ?? null %}
            {% set iconColor = card.iconColor ?? '' %}
            {% set heading = card.heading ?? '' %}
            {% set headingColor = card.headingColor ?? '' %}
            {% set description = card.description ?? card.subheading ?? '' %}
            {% set descriptionColor = card.descriptionColor ?? card.subheadingColor ?? '' %}
            {% set hoverColor = card.hoverColor ?? '#e35630' %}
            {% set isSvg = iconUrl is not empty and (iconMimeType == 'image/svg+xml' or iconUrl matches '/\\.svg(\\?.*)?$/') %}

            <div
                class="mw-card-grid__card"
                style="--mw-card-grid-hover-color: {{ hoverColor }};"
            >
                <div class="mw-card-grid__top">
                    <span class="mw-card-grid__badge">
                        {{ titleBesideBadge ? index : '%02d'|format(index) }}
                    </span>

                    {% if titleBesideBadge and heading is not empty %}
                        <h3 class="mw-card-grid__heading mw-card-grid__heading--inline" {% if headingColor is not empty %}style="color: {{ headingColor }};"{% endif %}>{{ heading }}</h3>
                    {% endif %}

                    {% if iconUrl %}
                        {% if isSvg and iconColor is not empty %}
                            <span
                                class="mw-card-grid__icon mw-card-grid__icon--mask"
                                style="background-color: {{ iconColor }}; -webkit-mask-image: url('{{ iconUrl }}'); mask-image: url('{{ iconUrl }}');"
                                aria-hidden="true"
                            ></span>
                        {% else %}
                            <img class="mw-card-grid__icon" src="{{ iconUrl }}" alt="" loading="lazy">
                        {% endif %}
                    {% endif %}
                </div>

                {% if not titleBesideBadge and heading is not empty %}
                    <h3 class="mw-card-grid__heading" {% if headingColor is not empty %}style="color: {{ headingColor }};"{% endif %}>{{ heading }}</h3>
                {% endif %}

                {% if description is not empty %}
                    <div class="mw-card-grid__description" {% if descriptionColor is not empty %}style="color: {{ descriptionColor }};"{% endif %}>
                        {{ description|raw }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% endblock %}
