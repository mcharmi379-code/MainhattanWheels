{% block element_mw_before_after %}
    {% set c = element.config %}
    {% set items = element.data.items ?? c.items.value ?? [] %}
    {% set columns = c.columns.value ?? 3 %}
    {% set showHeading = c.showHeading.value is not same as(false) %}
    {% set showSubHeading = c.showSubHeading.value is not same as(false) %}
    {% set showDescription = c.showDescription.value is not same as(false) %}
    {% set showTagsOnImage = c.showTagsOnImage.value is not same as(false) %}
    {% set isSingleColumn = columns == 1 %}

    {% if items|length > 0 %}
        <div class="cms-element-mw-before-after">
            <div class="mw-before-after-grid columns-{{ columns }}{% if isSingleColumn %} is--single-column{% endif %}">
                {% for item in items %}
                    {% set beforeImageUrl = item.beforeImageMedia.url ?? item.beforeImageUrl %}
                    {% set afterImageUrl = item.afterImageMedia.url ?? item.afterImageUrl %}

                    <div class="mw-before-after-card">
                        {% if isSingleColumn %}
                            <div class="mw-before-after-card__hero">
                                {% if showHeading and c.heading.value is not empty %}
                                    <p class="mw-before-after-kicker" style="color: {{ c.headingColor.value ?: '#e06600' }};">
                                        {{ c.heading.value }}
                                    </p>
                                {% endif %}

                                {% if showSubHeading and c.subHeading.value is not empty %}
                                    <h3 class="mw-before-after-heading">
                                        {{ c.subHeading.value }}
                                    </h3>
                                {% endif %}

                                {% if showDescription and c.description.value is not empty %}
                                    <div class="mw-before-after-description">
                                        {{ c.description.value|raw }}
                                    </div>
                                {% endif %}
                            </div>
                        {% else %}
                            {% if showHeading and c.heading.value is not empty %}
                                <p class="mw-before-after-kicker" style="color: {{ c.headingColor.value ?: '#e06600' }};">
                                    {{ c.heading.value }}
                                </p>
                            {% endif %}

                            {% if showSubHeading and c.subHeading.value is not empty %}
                                <h3 class="mw-before-after-heading">
                                    {{ c.subHeading.value }}
                                </h3>
                            {% endif %}

                            {% if showDescription and c.description.value is not empty %}
                                <div class="mw-before-after-description">
                                    {{ c.description.value|raw }}
                                </div>
                            {% endif %}
                        {% endif %}

                        <div class="mw-before-after-slider-wrapper" data-mw-before-after="true">
                            {% if showTagsOnImage %}
                                <div class="mw-before-after-overlay-tags" aria-hidden="true">
                                    {% if item.beforeText is not empty %}
                                        <span class="mw-before-after-text-tag mw-before-after-text-tag--before" style="color: {{ item.beforeTextColor ?: '#ffffff' }}; background-color: {{ item.beforeTextBackgroundColor ?: '#111827' }};">
                                            {{ item.beforeText }}
                                        </span>
                                    {% endif %}

                                    {% if item.afterText is not empty %}
                                        <span class="mw-before-after-text-tag mw-before-after-text-tag--after" style="color: {{ item.afterTextColor ?: '#ffffff' }}; background-color: {{ item.afterTextBackgroundColor ?: '#f97316' }};">
                                            {{ item.afterText }}
                                        </span>
                                    {% endif %}
                                </div>
                            {% endif %}

                            <div class="mw-before-after-slider">
                                <div class="mw-before-after-img after-img-container">
                                    {% if afterImageUrl is not empty %}
                                        <img src="{{ afterImageUrl }}" class="after-img" alt="After" loading="lazy" />
                                    {% else %}
                                        <div class="mw-before-after-placeholder">After Image</div>
                                    {% endif %}
                                </div>

                                <div class="mw-before-after-overlay">
                                    <div class="before-img-container">
                                        {% if beforeImageUrl is not empty %}
                                            <img src="{{ beforeImageUrl }}" class="before-img" alt="Before" loading="lazy" />
                                        {% else %}
                                            <div class="mw-before-after-placeholder">Before Image</div>
                                        {% endif %}
                                    </div>
                                </div>

                                <div class="mw-before-after-handle" style="left: 50%;" aria-hidden="true">
                                    <div class="mw-before-after-handle-line"></div>
                                    <button class="mw-before-after-handle-button" type="button" aria-label="Swap images">
                                        <svg class="mw-ba-swap-icon" viewBox="0 0 24 24" width="16" height="16">
                                            <path fill="currentColor" d="M19,8L15,12H18A6,6 0 0,1 12,18C11,18 10.1,17.7 9.3,17.2L7.9,18.6C9.1,19.5 10.5,20 12,20A8,8 0 0,0 20,12H23L19,8M6,12A6,6 0 0,1 12,6C13,6 13.9,6.3 14.7,6.8L16.1,5.4C14.9,4.5 13.5,4 12,4A8,8 0 0,0 4,12H1L5,16L9,12H6Z" />
                                        </svg>
                                    </button>
                                    <div class="mw-before-after-handle-line"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mw-before-after-card__details">
                            {% if not showTagsOnImage %}
                                {% if item.beforeText is not empty %}
                                    <p class="mw-before-after-text-tag" style="color: {{ item.beforeTextColor ?: '#ffffff' }}; background-color: {{ item.beforeTextBackgroundColor ?: '#111827' }};">
                                        {{ item.beforeText }}
                                    </p>
                                {% endif %}
                            {% endif %}

                            {% if item.beforeDescription is not empty %}
                                <p class="mw-before-after-text">
                                    {{ item.beforeDescription }}
                                </p>
                            {% endif %}

                            {% if not showTagsOnImage %}
                                {% if item.afterText is not empty %}
                                    <p class="mw-before-after-text-tag" style="color: {{ item.afterTextColor ?: '#ffffff' }}; background-color: {{ item.afterTextBackgroundColor ?: '#f97316' }};">
                                        {{ item.afterText }}
                                    </p>
                                {% endif %}
                            {% endif %}

                            {% if item.afterDescription is not empty %}
                                <p class="mw-before-after-text">
                                    {{ item.afterDescription }}
                                </p>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <script>
            (() => {
                const initCompareSlider = (root) => {
                    const slider = root.querySelector('.mw-before-after-slider');
                    const overlay = root.querySelector('.mw-before-after-overlay');
                    const handle = root.querySelector('.mw-before-after-handle');
                    const beforeImgContainer = root.querySelector('.before-img-container');

                    if (!slider || !overlay || !handle) {
                        return;
                    }

                    const setPosition = (clientX) => {
                        const rect = slider.getBoundingClientRect();
                        if (!rect.width) {
                            return;
                        }

                        let pct = ((clientX - rect.left) / rect.width) * 100;
                        pct = Math.max(0, Math.min(100, pct));

                        overlay.style.width = pct + '%';
                        handle.style.left = pct + '%';
                    };

                    const syncWidth = () => {
                        if (beforeImgContainer) {
                            beforeImgContainer.style.width = slider.offsetWidth + 'px';
                        }
                    };

                    syncWidth();
                    window.addEventListener('resize', syncWidth, { passive: true });

                    let dragging = false;

                    const startDrag = (event) => {
                        if (event.button !== undefined && event.button !== 0) {
                            return;
                        }

                        dragging = true;
                        if (slider.setPointerCapture && event.pointerId !== undefined) {
                            slider.setPointerCapture(event.pointerId);
                        }
                        setPosition(event.clientX);
                        event.preventDefault();
                    };

                    slider.addEventListener('pointerdown', startDrag, { passive: false });
                    slider.addEventListener('pointermove', (event) => {
                        if (!dragging) {
                            return;
                        }

                        setPosition(event.clientX);
                    }, { passive: true });
                    slider.addEventListener('pointerup', (event) => {
                        dragging = false;
                        if (slider.releasePointerCapture && event.pointerId !== undefined) {
                            slider.releasePointerCapture(event.pointerId);
                        }
                    }, { passive: true });
                    slider.addEventListener('pointercancel', () => {
                        dragging = false;
                    }, { passive: true });

                    const tapHandler = (event) => {
                        if (event.target.closest('button')) {
                            return;
                        }

                        const rect = slider.getBoundingClientRect();
                        if (!rect.width) {
                            return;
                        }

                        setPosition(event.clientX || (event.touches && event.touches[0] && event.touches[0].clientX) || rect.left + rect.width / 2);
                    };

                    slider.addEventListener('click', tapHandler);
                    slider.addEventListener('touchstart', tapHandler, { passive: true });
                };

                const boot = () => {
                    document.querySelectorAll('[data-mw-before-after="true"]').forEach(initCompareSlider);
                };

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', boot, { once: true });
                } else {
                    boot();
                }
            })();
        </script>
    {% endif %}
{% endblock %}
