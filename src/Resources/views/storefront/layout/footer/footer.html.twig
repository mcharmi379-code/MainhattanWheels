{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
<div class="mainhattan-footer-wrap">
    <div class="container">

        {# ===== NEWSLETTER BANNER (TOP OF FOOTER) ===== #}
        {% block footer_newsletter_bar %}
        <div class="footer-newsletter-box">
            <div class="row align-items-center">
                <div class="col-12 col-lg-7 footer-newsletter-box__left">
                    <div class="footer-newsletter-box__icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <path d="m22 7-10 7L2 7"/>
                        </svg>
                    </div>
                    <div class="footer-newsletter-box__text">
                        <h3 class="footer-newsletter-box__title">{{ 'footer.newsletter.barTitle'|trans|sw_sanitize }}</h3>
                        <p class="footer-newsletter-box__desc">{{ 'footer.newsletter.barDesc'|trans|sw_sanitize }}</p>
                    </div>
                </div>
                <div class="col-12 col-lg-5 footer-newsletter-box__right">
                    {% sw_include '@Storefront/storefront/component/footer/mainhattan-footer-newsletter.html.twig' with {
                        action: 'frontend.form.newsletter.register.handle.custom',
                        submitText: 'footer.newsletter.submitButton'
                    } %}
                </div>
            </div>
        </div>
        {% endblock %}

        {# ===== MAIN FOOTER COLUMNS ROW ===== #}
        {% block layout_footer_navigation %}
        <div id="footerColumns" class="row footer-columns" data-collapse-footer-columns="true" role="list">

            {# --- Column 1: Logo & Socials (col-md-3) --- #}
            <div class="col-12 col-md-3 footer-column footer-column--logo" role="listitem">
                <div class="js-collapse-footer-column-trigger d-none"></div>
                {% sw_include '@Storefront/storefront/component/footer/mainhattan-footer-logo.html.twig' %}
                <div class="footer-social-icons">
                    <a href="{{ 'footer.social.facebook'|trans|sw_sanitize }}" target="_blank" rel="noopener" aria-label="Facebook" class="footer-social-icons__link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                    <a href="{{ 'footer.social.instagram'|trans|sw_sanitize }}" target="_blank" rel="noopener" aria-label="Instagram" class="footer-social-icons__link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                    </a>
                    <a href="{{ 'footer.social.youtube'|trans|sw_sanitize }}" target="_blank" rel="noopener" aria-label="YouTube" class="footer-social-icons__link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#1a1a1a"/></svg>
                    </a>
                    <a href="{{ 'footer.social.linkedin'|trans|sw_sanitize }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer-social-icons__link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                    </a>
                </div>
            </div>

            {# --- Column 2 & 3: Navigation Columns (col-md-2 each for Shop Service & Information) --- #}
            {% block layout_footer_navigation_columns %}
                {% for root in page.footer.navigation.tree %}
                    <div class="col-12 col-md-2 footer-column js-footer-column" role="listitem">
                        {% block layout_footer_navigation_column %}
                            {% block layout_footer_navigation_information_headline %}
                                <div class="footer-column-headline footer-headline js-collapse-footer-column-trigger accordion">
                                    <p class="footer__title">
                                        {{ root.category.translated.name }}
                                    </p>
                                    <div class="footer-column-toggle">
                                        <span class="footer-chevron-icon">
                                            {% sw_icon 'ic-chevron-right-dark' style { 'pack': 'mainhattan', 'size': 'xs' } %}
                                        </span>
                                    </div>
                                </div>
                            {% endblock %}

                            {% block layout_footer_navigation_information_content %}
                                <div class="footer-column-content collapse js-footer-column-content panel">
                                    <div class="footer-column-content-inner">
                                        <ul class="list-unstyled">
                                            {% for treeItem in root.children %}
                                                {% set cssClass = treeItem.category.customFields.css_classes %}
                                                {% set category = treeItem.category %}
                                                {% set name = category.translated.name %}
                                                <li class="footer-link-item">
                                                    <a class="footer-link {% if cssClass is not null %}{{ cssClass }}{% endif %}"
                                                       href="{{ category_url(category) }}"
                                                       {% if category_linknewtab(category) %}target="_blank"{% endif %}
                                                       title="{{ name }}">
                                                        <span class="footer-link__arrow">›</span>
                                                        {{ name }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                </div>
                            {% endblock %}
                        {% endblock %}
                    </div>
                {% endfor %}
            {% endblock %}

            {# --- Column 4: Map (col-md-3) --- #}
            {% block footer_layout_handler %}
                <div class="col-12 col-md-3 footer-column js-footer-column" role="listitem">
                    <div class="footer-column-headline footer-headline js-collapse-footer-column-trigger accordion">
                        <p class="footer__title">
                            {{ "footer.map.mapTitle"|trans|sw_sanitize }}
                        </p>
                        <div class="footer-column-toggle">
                            <span class="footer-chevron-icon">
                                {% sw_icon 'ic-chevron-right-dark' style { 'pack': 'mainhattan', 'size': 'xs' } %}
                            </span>
                        </div>
                    </div>
                    <div class="footer-column-content collapse js-footer-column-content panel">
                        <div class="google-map">
                            <iframe
                                title="Google Maps Karte – Standort von Mainhattan-Wheels"
                                width="100%"
                                height="200"
                                frameborder="0"
                                style="border:0"
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11277.917218796614!2d8.790863!3d50.011491!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3AYOUR_LOCATION_NAME_HERE!2sMainhattan-Wheels!5e0!3m2!1sen!2sus!4v1567429023614!5m2!1sen!2sus"
                            ></iframe>
                        </div>
                        <div class="footer-address">
                            <span class="footer-address__pin">📍</span>
                            <span>
                                {{ "footer.addressLineOne"|trans|sw_sanitize }}<br>
                                {{ "footer.addressLineTwo"|trans|sw_sanitize }}<br>
                                {{ "footer.addressLineThree"|trans|sw_sanitize }}
                            </span>
                        </div>
                    </div>
                </div>
            {% endblock %}

            {# --- Column 5: Service & Hotline (col-md-2) --- #}
            {% block footer_newsletter %}
                <div class="col-12 col-md-2 footer-column js-footer-column" role="listitem">
                    <div class="footer-column-headline footer-headline js-collapse-footer-column-trigger accordion">
                        <p class="footer__title">
                            {{ 'footer.opening.openingTitles'|trans|sw_sanitize }}
                        </p>
                        <div class="footer-column-toggle">
                            <span class="footer-chevron-icon">
                                {% sw_icon 'ic-chevron-right-dark' style { 'pack': 'mainhattan', 'size': 'xs' } %}
                            </span>
                        </div>
                    </div>
                    <div class="footer-column-content collapse js-footer-column-content panel">
                        <div class="footer-hotline">
                            <div class="footer-hotline__phone">
                                <span class="footer-hotline__icon">📞</span>
                                <span>{{ 'footer.contact.telephone'|trans|sw_sanitize }}</span>
                            </div>
                            <div class="footer-hotline__hours">
                                <span class="footer-hotline__icon">🕒</span>
                                <span>
                                    {{ 'footer.opening.openingDays'|trans|sw_sanitize }}<br>
                                    {{ 'footer.opening.openingTimes'|trans|sw_sanitize|raw }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            {% endblock %}

        </div>
        {% endblock %}

    </div>
</div>
{% endblock %}

{# ===== OVERRIDE SERVICE MENU AND VAT (HIDE DEFAULT) ===== #}
{% block layout_footer_service_menu %}{% endblock %}
{% block layout_footer_vat %}{% endblock %}

{# ===== OVERRIDE COPYRIGHT BLOCK (SHOPWARE STANDARD FOOTER BOTTOM) ===== #}
{% block layout_footer_copyright %}
    <div class="footer-copyright-custom-bar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 col-md-8 text-start">
                    <span class="footer-copyright-text">
                        {{ 'footer.copyright'|trans|sw_sanitize }}
                    </span>
                </div>
                <div class="col-12 col-md-4 text-end">
                    <a href="{{ path('frontend.home.page') }}" class="footer-back-to-top">
                        {{ 'footer.backToTop'|trans|sw_sanitize }} →
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
